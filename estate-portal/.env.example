# Neon / Postgres (required)
# Pooled URL for the app (Neon "DATABASE_URL", often includes -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
# Direct / unpooled URL for migrations (Neon "DATABASE_URL_UNPOOLED" or DIRECT_URL)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

AUTH_SECRET="generate-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Optional locally. On Vercel, create a Private Blob store and connect it to the
# project so uploads persist (OIDC + BLOB_STORE_ID, or BLOB_READ_WRITE_TOKEN).
# BLOB_READ_WRITE_TOKEN=""
# BLOB_STORE_ID=""

# Invite email (Resend). Verify probateguardians.com in Resend, then set:
# RESEND_API_KEY="re_..."
# INVITE_FROM_EMAIL="Probate Guardians <portal@probateguardians.com>"
