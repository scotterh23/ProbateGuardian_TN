generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  EXECUTOR
  HEIR
  ATTORNEY
}

enum EstateStatus {
  LETTERS
  VALUATION
  LISTED
  UNDER_CONTRACT
  CLOSED
}

enum TransactionStatus {
  INSPECTION
  APPRAISAL
  FINANCING
  CLEAR_TO_CLOSE
}

enum EstateProgress {
  LETTERS_ISSUED
  INVENTORY_FILED
  NOTICE_TO_CREDITORS
  CREDITOR_PERIOD_ENDED
  DEBTS_TAXES_SETTLED
  FINAL_ACCOUNTING
  ESTATE_CLOSED
}

enum DocumentCategory {
  WILL
  LETTERS
  APPRAISAL
  PHOTOS
  CONTRACTS
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())

  memberships EstateMember[]
  updates     EstateUpdate[]
  comments    UpdateComment[]
  documents   Document[]
  questions   EstateQuestion[]
  invitesSent Invite[]       @relation("InvitedBy")
}

model Estate {
  id        String       @id @default(cuid())
  nickname  String
  address   String
  city      String
  county    String
  status    EstateStatus   @default(LETTERS)
  progress  EstateProgress @default(LETTERS_ISSUED)
  estimatedValue     Int?
  listPrice          Int?
  listingNotes       String?
  contractPrice      Int?
  transactionStatus  TransactionStatus?
  salePrice          Int?
  netToEstate        Int?
  netNotes           String?
  cashOfferRange     String?
  cashNet            Int?
  cashNotes          String?
  prepCosts          Int?
  marketNet          Int?
  marketNotes        String?
  createdAt DateTime       @default(now())
  updatedAt DateTime     @updatedAt

  members   EstateMember[]
  updates   EstateUpdate[]
  documents Document[]
  questions EstateQuestion[]
  invites   Invite[]
}

model EstateMember {
  id        String   @id @default(cuid())
  estateId  String
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([estateId, userId])
}

model EstateUpdate {
  id        String   @id @default(cuid())
  estateId  String
  authorId  String
  body      String
  fileName  String?
  filePath  String?
  fileMime  String?
  createdAt DateTime @default(now())

  estate   Estate          @relation(fields: [estateId], references: [id], onDelete: Cascade)
  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments UpdateComment[]
}

model UpdateComment {
  id        String   @id @default(cuid())
  updateId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  update EstateUpdate @relation(fields: [updateId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model EstateQuestion {
  id        String   @id @default(cuid())
  estateId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  estate Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([estateId, createdAt])
}

model Document {
  id         String           @id @default(cuid())
  estateId   String
  uploadedById String
  category   DocumentCategory @default(OTHER)
  fileName   String
  filePath   String
  fileMime   String
  fileSize   Int
  createdAt  DateTime         @default(now())

  estate     Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  uploadedBy User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model Invite {
  id        String    @id @default(cuid())
  email     String
  role      UserRole
  estateId  String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  invitedById String

  estate    Estate @relation(fields: [estateId], references: [id], onDelete: Cascade)
  invitedBy User   @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
}
